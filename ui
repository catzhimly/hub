-- Minimize / close / open logic
local minimized = false
local maximized = false
local fullSize = FULL_SIZE          -- size the window returns to when un-minimized
local normalPosition = main.Position
local tweenInfo = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local sizeTween = TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
local normalSize = FULL_SIZE        -- size to go back to after 变大 / 还原
local customSize = false            -- true once you have resized the window yourself

-- ===== Resize handle (bottom-right corner): drag it to change the window size =====
local MIN_W, MIN_H = 300, 200

local resizeHandle = Instance.new("TextButton")
resizeHandle.Name = "ResizeHandle"
resizeHandle.AnchorPoint = Vector2.new(1, 1)
resizeHandle.Size = UDim2.fromOffset(28, 28)
resizeHandle.Position = UDim2.new(1, -2, 1, -2)
resizeHandle.BackgroundTransparency = 1
resizeHandle.Text = ""
resizeHandle.AutoButtonColor = false
resizeHandle.ZIndex = 102
resizeHandle.Parent = main

-- three little diagonal lines as the grip icon
for _, grip in ipairs({ { 9, 8 }, { 15, 14 }, { 21, 20 } }) do
	local line = Instance.new("Frame")
	line.AnchorPoint = Vector2.new(0.5, 0.5)
	line.Position = UDim2.new(1, -grip[1], 1, -grip[1])
	line.Size = UDim2.fromOffset(grip[2], 2)
	line.Rotation = -45
	line.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	line.BackgroundTransparency = 0.35
	line.BorderSizePixel = 0
	line.Active = false
	line.ZIndex = 103
	line.Parent = resizeHandle
	round(line, 1)
end

local function updateHandle()
	resizeHandle.Visible = not minimized and not maximized
end

local resizing = false
local rStart, rStartSize, rStartPos, rMaxW, rMaxH

resizeHandle.InputBegan:Connect(function(input)
	if input.UserInputType ~= Enum.UserInputType.MouseButton1
		and input.UserInputType ~= Enum.UserInputType.Touch then
		return
	end
	if minimized or maximized then return end

	resizing = true
	rStart = input.Position
	rStartSize = main.AbsoluteSize
	rStartPos = main.Position
	-- can grow until the edge of the screen
	rMaxW = math.max(MIN_W, gui.AbsoluteSize.X - main.AbsolutePosition.X - 10)
	rMaxH = math.max(MIN_H, gui.AbsoluteSize.Y - main.AbsolutePosition.Y - 10)

	input.Changed:Connect(function()
		if input.UserInputState == Enum.UserInputState.End then
			resizing = false
		end
	end)
end)

UserInputService.InputChanged:Connect(function(input)
	if not resizing then return end
	if input.UserInputType ~= Enum.UserInputType.MouseMovement
		and input.UserInputType ~= Enum.UserInputType.Touch then
		return
	end

	local delta = input.Position - rStart
	local w = math.clamp(rStartSize.X + delta.X, MIN_W, rMaxW)
	local h = math.clamp(rStartSize.Y + delta.Y, MIN_H, rMaxH)

	customSize = true
	sizeLimit.MaxSize = Vector2.new(math.huge, math.huge) -- the 800x600 limit no longer applies
	fullSize = UDim2.fromOffset(w, h)
	main.Size = fullSize
	-- window is centered on its X anchor, so shift it to keep the top-left corner fixed
	main.Position = UDim2.new(
		rStartPos.X.Scale, rStartPos.X.Offset + (w - rStartSize.X) / 2,
		rStartPos.Y.Scale, rStartPos.Y.Offset
	)
end)

local function currentMinSize()
	return UDim2.new(fullSize.X.Scale, fullSize.X.Offset, 0, TITLE_HEIGHT + 12)
end

local function setMinimized(state)
	minimized = state
	updateHandle()
	if minimized then
		content.Visible = false
		minimizeBtn.Text = "+"
		TweenService:Create(main, tweenInfo, { Size = currentMinSize() }):Play()
	else
		minimizeBtn.Text = "-"
		TweenService:Create(main, tweenInfo, { Size = fullSize }):Play()
		task.delay(0.2, function()
			if not minimized then content.Visible = true end
		end)
	end
end

minimizeBtn.MouseButton1Click:Connect(function()
	setMinimized(not minimized)
end)

-- 变大: window becomes almost the whole screen (press again to go back)
maximizeBtn.MouseButton1Click:Connect(function()
	maximized = not maximized
	updateHandle()
	if maximized then
		normalPosition = main.Position
		normalSize = fullSize
		fullSize = MAX_SIZE
		sizeLimit.MaxSize = Vector2.new(math.huge, math.huge) -- remove the 800x600 limit
		maximizeBtn.Text = "还原"
		TweenService:Create(main, sizeTween, { Size = minimized and currentMinSize() or fullSize, Position = MAX_POSITION }):Play()
	else
		fullSize = normalSize
		maximizeBtn.Text = "变大"
		local t = TweenService:Create(main, sizeTween, { Size = minimized and currentMinSize() or fullSize, Position = normalPosition })
		t:Play()
		t.Completed:Connect(function()
			if not maximized and not customSize then
				sizeLimit.MaxSize = Vector2.new(800, 600) -- put the limit back
			end
		end)
	end
end)

closeBtn.MouseButton1Click:Connect(function()
	local t = TweenService:Create(mainScale, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Scale = 0.85 })
	t:Play()
	t.Completed:Wait()
	main.Visible = false
	mainScale.Scale = 1
	openBtn.Visible = true
end)

openBtn.MouseButton1Click:Connect(function()
