local function pageCircle(input)
	if input.UserInputType ~= Enum.UserInputType.MouseButton1
		and input.UserInputType ~= Enum.UserInputType.Touch then
		return
	end

	local size = pageClickLayer.AbsoluteSize
	if size.X <= 0 or size.Y <= 0 then return end
	local inset = GuiService:GetGuiInset()
	local rel = Vector2.new(input.Position.X, input.Position.Y) + inset - pageClickLayer.AbsolutePosition
	local px = math.clamp(rel.X / size.X, 0, 1)
	local py = math.clamp(rel.Y / size.Y, 0, 1)

	local circle = Instance.new("Frame")
	circle.AnchorPoint = Vector2.new(0.5, 0.5)
	circle.Position = UDim2.new(px, 0, py, 0)
	circle.Size = UDim2.fromOffset(0, 0)
	circle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	circle.BackgroundTransparency = 0.45
	circle.BorderSizePixel = 0
	circle.Active = false
	circle.Parent = pageClickLayer

	local cc = Instance.new("UICorner")
	cc.CornerRadius = UDim.new(1, 0)
	cc.Parent = circle

	local d = math.max(size.X, size.Y) * 1.6
	local t = TweenService:Create(circle, windowCircleTween, {
		Size = UDim2.fromOffset(d, d),
		BackgroundTransparency = 1,
	})
	t:Play()
	t.Completed:Connect(function()
		circle:Destroy()
	end)
end

