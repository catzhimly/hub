-- Open button (shown when the window is closed) - a round picture button
-- The picture is stored inside this script as base64 (no upload needed).
-- It needs an executor with writefile + getcustomasset. If yours does not have them,
-- upload the picture to Roblox and put its asset ID in OPEN_IMAGE_ID instead.
local OPEN_IMAGE_ID = 0
local OPEN_IMAGE_B64 = ""

local function decodeBase64(data)
	local chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
	local lookup = {}
	for i = 1, #chars do
		lookup[chars:byte(i)] = i - 1
	end
	local out, buffer, bits = {}, 0, 0
	for i = 1, #data do
		local v = lookup[data:byte(i)]
		if v then
			buffer = bit32.bor(bit32.lshift(buffer, 6), v)
			bits += 6
			if bits >= 8 then
				bits -= 8
				out[#out + 1] = string.char(bit32.band(bit32.rshift(buffer, bits), 255))
				buffer = bit32.band(buffer, bit32.lshift(1, bits) - 1)
			end
		end
	end
	return table.concat(out)
end

-- decode -> save as a file -> turn the file into an image Roblox can show
local function loadEmbeddedImage()
	local ok, asset = pcall(function()
		writefile("WindowUI_open_icon2.jpg", decodeBase64(OPEN_IMAGE_B64))
		return getcustomasset("WindowUI_open_icon2.jpg")
	end)
	if ok and type(asset) == "string" and asset ~= "" then
		return asset
	end
	return nil
end

