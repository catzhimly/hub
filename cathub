-- ===== 透视 page: ESP for all players / one chosen player =====
-- One "group" = one set of highlights + name tags. The all-players group and the
-- chosen-player group are separate, so each switch only touches its own.
local function newEspGroup(filter, color)
	local g = { data = {}, conns = {} }

	local function clearPlayer(plr)
		local o = g.data[plr]
		if not o then return end
		if o.conn then o.conn:Disconnect() end
		if o.hl then o.hl:Destroy() end
		if o.bb then o.bb:Destroy() end
		g.data[plr] = nil
	end

	local function build(plr, char)
		local o = g.data[plr]
		if not o then return end
		if o.hl then o.hl:Destroy() o.hl = nil end
		if o.bb then o.bb:Destroy() o.bb = nil end

		local root = char:WaitForChild("HumanoidRootPart", 10)
		if not root or g.data[plr] ~= o then return end

		local hl = Instance.new("Highlight")
		hl.Name = "EspHighlight"
		hl.FillColor = color
		hl.FillTransparency = 0.55
		hl.OutlineColor = Color3.fromRGB(255, 255, 255)
		hl.OutlineTransparency = 0
		hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		hl.Adornee = char
		hl.Parent = char

		local bb = Instance.new("BillboardGui")
		bb.Name = "EspTag"
		bb.Adornee = root
		bb.AlwaysOnTop = true
		bb.Size = UDim2.new(0, 140, 0, 30)
		bb.StudsOffset = Vector3.new(0, 3.5, 0)
		bb.Parent = root

		local label = Instance.new("TextLabel")
		label.Size = UDim2.new(1, 0, 1, 0)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.GothamBold
		label.TextSize = 14
		label.TextColor3 = Color3.fromRGB(255, 255, 255)
		label.TextStrokeTransparency = 0.3
		label.Text = plr.DisplayName
		label.Parent = bb

		o.hl, o.bb, o.label, o.root = hl, bb, label, root
	end

	local function setup(plr)
		if g.data[plr] or not filter(plr) then return end
		local o = {}
		g.data[plr] = o
		o.conn = plr.CharacterAdded:Connect(function(char)
			task.spawn(build, plr, char)
		end)
		if plr.Character then
			task.spawn(build, plr, plr.Character)
		end
	end

	-- add the players that should be shown, remove the ones that should not
	function g.refresh()
		if not g.enabled then return end
		for _, plr in ipairs(Players:GetPlayers()) do
			if filter(plr) then
				setup(plr)
			else
				clearPlayer(plr)
			end
		end
		for plr in pairs(g.data) do
			if not plr.Parent or not filter(plr) then
				clearPlayer(plr)
			end
		end
	end

	function g.set(state)
		g.enabled = state
		for _, c in ipairs(g.conns) do c:Disconnect() end
		g.conns = {}
		for plr in pairs(g.data) do clearPlayer(plr) end
		if not state then return end

		g.refresh()
		g.conns[#g.conns + 1] = Players.PlayerAdded:Connect(setup)
		g.conns[#g.conns + 1] = Players.PlayerRemoving:Connect(clearPlayer)

		-- distance under each name (updated 4 times a second)
		local acc = 0
		g.conns[#g.conns + 1] = RunService.Heartbeat:Connect(function(dt)
			acc += dt
			if acc < 0.25 then return end
			acc = 0
			local myChar = player.Character
			local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
			for plr, o in pairs(g.data) do
				if o.label and o.root and o.root.Parent then
					if myRoot then
						local d = (o.root.Position - myRoot.Position).Magnitude
						o.label.Text = plr.DisplayName .. "  [" .. math.floor(d) .. "m]"
					else
						o.label.Text = plr.DisplayName
					end
				end
			end
		end)
	end

	return g
end

