-- Helper to round corners
local function round(obj, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius or 8)
	c.Parent = obj
end

-- ===== LIQUID GLASS HELPERS =====
local mode = "normal"   -- "normal" = WindowUI2 style, "effects" = WindowUI style
local effectParts = {}   -- everything that only shows in effects mode
local edgeGradients = {} -- rotated every frame so the light slides around the edges
local shimmers = {}       -- light streaks that sweep across the glass
local blobs = {}          -- soft colored lights that drift behind the window

RunService.RenderStepped:Connect(function(dt)
	if mode ~= "effects" then return end
	local now = os.clock()

	for i = #edgeGradients, 1, -1 do
		local g = edgeGradients[i]
		if g.Parent then
			g.Rotation = (g.Rotation + 50 * dt) % 360
		else
			table.remove(edgeGradients, i)
		end
	end

	for i = #shimmers, 1, -1 do
		local sh = shimmers[i]
		if sh.grad.Parent then
			local u = ((now + sh.phase) % 4) / 4
			if u < 0.45 then
				sh.grad.Offset = Vector2.new(-1 + (u / 0.45) * 2, 0) -- sweep across
			else
				sh.grad.Offset = Vector2.new(-1, 0) -- rest (hidden)
			end
		else
			table.remove(shimmers, i)
		end
	end

	for _, blob in ipairs(blobs) do
		blob.frame.Position = UDim2.new(
			0.5 + 0.4 * math.sin(now * 0.45 + blob.phase), 0,
			0.5 + 0.4 * math.cos(now * 0.35 + blob.phase * 1.3), 0
		)
	end
end)

-- Makes an element look like liquid glass:
-- see-through body, glossy top highlight, and a soft white edge
local function glass(obj, bgTransparency, edgeTransparency, glossTransparency)
	obj.BackgroundTransparency = bgTransparency

	-- soft sheen across the whole body
	local sheen = Instance.new("UIGradient")
	sheen.Name = "GlassSheen"
	sheen.Rotation = 45
	sheen.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(200, 200, 214))
	sheen.Parent = obj

	-- glossy highlight on the top half (like light reflecting on a bubble)
	if glossTransparency ~= false then
	local corner = obj:FindFirstChildOfClass("UICorner")
	local gloss = Instance.new("Frame")
	gloss.Name = "Gloss"
	gloss.Size = UDim2.new(1, -8, 0.5, -2)
	gloss.Position = UDim2.new(0, 4, 0, 2)
	gloss.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	gloss.BorderSizePixel = 0
	gloss.Active = false
	gloss.Parent = obj

	local glossCorner = Instance.new("UICorner")
	glossCorner.CornerRadius = corner and corner.CornerRadius or UDim.new(0, 8)
	glossCorner.Parent = gloss

	local glossFade = Instance.new("UIGradient")
	glossFade.Rotation = 90
	glossFade.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, glossTransparency or 0.82),
		NumberSequenceKeypoint.new(1, 1),
	})
	glossFade.Parent = gloss

	-- tiny bright glints on the top and bottom edges, like light bending in thick glass
	local function glint(posX, posY, color, alpha)
		local g = Instance.new("Frame")
		g.Name = "Glint"
		g.AnchorPoint = Vector2.new(0, posY)
		g.Position = UDim2.new(posX, 0, posY, posY == 1 and -3 or 3)
		g.Size = UDim2.new(0.3, 0, 0, 2)
		g.BackgroundColor3 = color
		g.BorderSizePixel = 0
		g.Active = false
		g.Visible = false
		g.Parent = obj
		table.insert(effectParts, g)

		local gc = Instance.new("UICorner")
		gc.CornerRadius = UDim.new(1, 0)
		gc.Parent = g

		local gf = Instance.new("UIGradient")
		gf.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.5, alpha),
			NumberSequenceKeypoint.new(1, 1),
		})
		gf.Parent = g
	end
	glint(0.14, 0, Color3.fromRGB(255, 255, 255), 0.15)
	glint(0.58, 1, Color3.fromRGB(170, 225, 255), 0.45)

	-- a streak of light that sweeps across the glass every few seconds
	local shimmer = Instance.new("Frame")
	shimmer.Name = "Shimmer"
	shimmer.Size = UDim2.new(1, 0, 1, 0)
	shimmer.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	shimmer.BorderSizePixel = 0
	shimmer.Active = false
	shimmer.Visible = false
	shimmer.Parent = obj
	table.insert(effectParts, shimmer)

	local shimmerCorner = Instance.new("UICorner")
	shimmerCorner.CornerRadius = corner and corner.CornerRadius or UDim.new(0, 8)
	shimmerCorner.Parent = shimmer

	local band = Instance.new("UIGradient")
	band.Rotation = 25
	band.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.4, 1),
		NumberSequenceKeypoint.new(0.5, 0.78),
		NumberSequenceKeypoint.new(0.6, 1),
		NumberSequenceKeypoint.new(1, 1),
	})
	band.Offset = Vector2.new(-1, 0)
	band.Parent = shimmer
	table.insert(shimmers, { grad = band, phase = math.random() * 4 })
	end

	-- plain white glowing edge
	local stroke = Instance.new("UIStroke")
	stroke.Name = "GlassEdge"
	stroke.Color = Color3.fromRGB(255, 255, 255)
	stroke.Thickness = 1.5
	stroke.Transparency = edgeTransparency or 0.5
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = obj

	local edge = Instance.new("UIGradient")
	edge.Rotation = math.random(0, 359)
	edge.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
		ColorSequenceKeypoint.new(0.35, Color3.fromRGB(165, 225, 255)),
		ColorSequenceKeypoint.new(0.65, Color3.fromRGB(255, 190, 235)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 255, 255)),
	})
	edge.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(0.5, 0.8),
		NumberSequenceKeypoint.new(1, 0),
	})
	edge.Enabled = false
	edge.Parent = stroke
	table.insert(effectParts, edge)
	table.insert(edgeGradients, edge)

	-- easier to read on bright backgrounds
	if obj:IsA("TextButton") then
		obj.TextStrokeTransparency = 0.75
	end
end

-- iPhone-style press: the glass squishes in and glows, then springs back, with a circle
local function liquidClick(button, radius)
	local scale = Instance.new("UIScale")
	scale.Parent = button

	local clip = Instance.new("CanvasGroup") -- CanvasGroup + UICorner = ripple stays inside the round shape
	clip.Name = "Ripples"
	clip.Size = UDim2.new(1, 0, 1, 0)
	clip.BackgroundTransparency = 1
	clip.Active = false
	clip.Parent = button
	round(clip, radius or 8)

	local stroke = button:FindFirstChild("GlassEdge")
	local baseBg = button.BackgroundTransparency
	local baseEdge = stroke and stroke.Transparency or 0.5
	local baseThick = stroke and stroke.Thickness or 1.5

	local pressTween = TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local springTween = TweenInfo.new(0.7, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out)
	local fadeTween = TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local rippleTween = TweenInfo.new(1.2, Enum.EasingStyle.Sine, Enum.EasingDirection.Out) -- same click circle speed in both modes

	local function release()
		TweenService:Create(scale, springTween, { Scale = 1 }):Play()
		TweenService:Create(button, fadeTween, { BackgroundTransparency = baseBg }):Play()
		if stroke then
			TweenService:Create(stroke, fadeTween, { Thickness = baseThick, Transparency = baseEdge }):Play()
		end
	end

	button.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1
			and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end

		-- squish + glow
		TweenService:Create(scale, pressTween, { Scale = 0.9 }):Play()
		TweenService:Create(button, pressTween, { BackgroundTransparency = math.max(baseBg - 0.25, 0) }):Play()
		if stroke then
			TweenService:Create(stroke, pressTween, { Thickness = baseThick * 2.2, Transparency = 0.05 }):Play()
		end

		-- circle that starts where you pressed
		local size = clip.AbsoluteSize
		if size.X <= 0 or size.Y <= 0 then return end
		local inset = GuiService:GetGuiInset()
		local rel = Vector2.new(input.Position.X, input.Position.Y) + inset - clip.AbsolutePosition
		local px = math.clamp(rel.X / size.X, 0, 1)
		local py = math.clamp(rel.Y / size.Y, 0, 1)

		local ripple = Instance.new("Frame")
		ripple.AnchorPoint = Vector2.new(0.5, 0.5)
		ripple.Position = UDim2.new(px, 0, py, 0)
		ripple.Size = UDim2.fromOffset(0, 0)
		ripple.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
		ripple.BackgroundTransparency = 0.45
		ripple.BorderSizePixel = 0
		ripple.Active = false
		ripple.Parent = clip

		local rc = Instance.new("UICorner")
		rc.CornerRadius = UDim.new(1, 0)
		rc.Parent = ripple

		local d = math.max(size.X, size.Y) * 2.6
		local t = TweenService:Create(ripple, rippleTween, {
			Size = UDim2.fromOffset(d, d),
			BackgroundTransparency = 1,
		})
		t:Play()
		t.Completed:Connect(function()
			ripple:Destroy()
		end)
	end)

	button.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			release()
		end
	end)
	button.MouseLeave:Connect(release)
end

