-- A row with  ( -  [ type a number ]  + ):  press - / + (hold to keep changing)
-- or tap the number and type your own value
local function addValueRow(page, name, minV, maxV, step, getValue, setValue)
	local row = Instance.new("Frame")
	row.Name = name .. "Row"
	row.Size = UDim2.new(1, 0, 0, 36)
	row.BackgroundTransparency = 1
	row.LayoutOrder = #page:GetChildren()
	row.Parent = page

	local box -- the text box in the middle

	local function change(v)
		setValue(math.clamp(math.floor(v + 0.5), minV, maxV))
		if box and not box:IsFocused() then
			box.Text = name .. ":  " .. getValue()
		end
	end

	local function stepButton(text, anchorX, direction)
		local b = Instance.new("TextButton")
		b.AnchorPoint = Vector2.new(anchorX, 0)
		b.Position = UDim2.new(anchorX, 0, 0, 0)
		b.Size = UDim2.new(0, 56, 1, 0)
		b.BackgroundColor3 = INACTIVE_COLOR
		b.Text = text
		b.Font = Enum.Font.GothamBold
		b.TextSize = 20
		b.TextColor3 = Color3.fromRGB(255, 255, 255)
		b.Parent = row
		round(b, 18)
		glass(b, 0.45, 0.45, 0.78)
		liquidClick(b, 18)

		-- one step per press; keep holding to repeat faster
		local holdId = 0
		local function stop() holdId += 1 end
		b.InputBegan:Connect(function(input)
			if input.UserInputType ~= Enum.UserInputType.MouseButton1
				and input.UserInputType ~= Enum.UserInputType.Touch then
				return
			end
			holdId += 1
			local id = holdId
			change(getValue() + direction * step)
			task.spawn(function()
				task.wait(0.4)
				while holdId == id do
					change(getValue() + direction * step)
					task.wait(0.05)
				end
			end)
		end)
		b.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				stop()
			end
		end)
		b.MouseLeave:Connect(stop)
		return b
	end

	stepButton("-", 0, -1)
	stepButton("+", 1, 1)

	box = Instance.new("TextBox")
	box.Name = name .. "Box"
	box.Position = UDim2.new(0, 62, 0, 0)
	box.Size = UDim2.new(1, -124, 1, 0)
	box.BackgroundColor3 = INACTIVE_COLOR
	box.Font = Enum.Font.GothamMedium
	box.TextSize = 15
	box.TextColor3 = Color3.fromRGB(255, 255, 255)
	box.PlaceholderText = "输入" .. name
	box.ClearTextOnFocus = false
	box.Text = name .. ":  " .. getValue()
	box.Parent = row
	round(box, 18)
	glass(box, 0.55, 0.5, 0.78)

	-- tapping the box: show just the number so you can type
	box.Focused:Connect(function()
		box.Text = tostring(getValue())
	end)
	-- done typing: use the number (clamped to min/max), or keep the old one if it is not a number
	box.FocusLost:Connect(function()
		local typed = tonumber(box.Text:match("%d+%.?%d*"))
		box.Text = name .. ":  " .. getValue()
		if typed then
			change(typed)
		end
	end)
end

