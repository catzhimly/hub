local speedEnabled = false
local speedValue = 50
local originalSpeed = 16
local SPEED_MIN, SPEED_MAX, SPEED_STEP = 1, 300, 10   -- speed limit is 300

local jumpEnabled = false
local jumpValue = 100                                  -- jump strength (50 = normal Roblox jump)
local originalJumpPower, originalJumpHeight = 50, 7.2
local JUMP_MIN, JUMP_MAX, JUMP_STEP = 1, 500, 10

local function getHumanoid()
	local char = player.Character
	return char and char:FindFirstChildOfClass("Humanoid")
end

local function jumpHeightFor(power)
	return power ^ 2 / (2 * workspace.Gravity) -- same physics Roblox uses for JumpPower
end

-- restore = true only when switching OFF (puts the original value back);
-- while off we never touch the game's own values
local function applySpeed(restore)
	local hum = getHumanoid()
	if not hum then return end
	if speedEnabled then
		hum.WalkSpeed = speedValue
	elseif restore then
		hum.WalkSpeed = originalSpeed
	end
end

local function applyJump(restore)
	local hum = getHumanoid()
	if not hum then return end
	if jumpEnabled then
		if hum.UseJumpPower then
			hum.JumpPower = jumpValue
		else
			hum.JumpHeight = jumpHeightFor(jumpValue)
		end
	elseif restore then
		hum.JumpPower = originalJumpPower
		hum.JumpHeight = originalJumpHeight
	end
end

-- keep speed / jump after respawning, and if the game tries to change them back
local function hookHumanoid(char)
	local hum = char:WaitForChild("Humanoid")
	hum:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
		if speedEnabled and hum.WalkSpeed ~= speedValue then
			hum.WalkSpeed = speedValue
		end
	end)
	hum:GetPropertyChangedSignal("JumpPower"):Connect(function()
		if jumpEnabled and hum.UseJumpPower and hum.JumpPower ~= jumpValue then
			hum.JumpPower = jumpValue
		end
	end)
	hum:GetPropertyChangedSignal("JumpHeight"):Connect(function()
		local h = jumpHeightFor(jumpValue)
		if jumpEnabled and not hum.UseJumpPower and math.abs(hum.JumpHeight - h) > 0.001 then
			hum.JumpHeight = h
		end
	end)
	applySpeed()
	applyJump()
end
if player.Character then task.spawn(hookHumanoid, player.Character) end
