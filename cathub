-- returns the hidden count, or nil when the script stopped early (not Delta)
local function hideDelta()
	local chunk, err = loadstring(DELTA_HIDER_SOURCE)
	if not chunk then
		error("loadstring: " .. tostring(err))
	end
	local count = chunk() -- your original logic
	if count == nil then
		return nil
	end

	-- Extra pass: your logic only finds the icon when its picture is called "Logo.png".
	-- If the icon is still showing (for example a custom icon), also hide any other enabled
	-- gui in gethui() that is just a small picture button. Names are printed to the console.
	for _, v in pairs(gethui():GetChildren()) do
		if v:IsA("ScreenGui") and v.Enabled and v ~= gui then
			local iconButton
			for _, d in ipairs(v:GetDescendants()) do
				if d:IsA("ImageButton") and d.Visible and tostring(d.Image) ~= ""
					and d.AbsoluteSize.X > 0 and d.AbsoluteSize.X <= 160 and d.AbsoluteSize.Y <= 160 then
					iconButton = d
					break
				end
			end
			if iconButton then
				print("[WindowUI] hid extra icon gui: " .. v.Name .. " | " .. tostring(iconButton.Image))
				v.Enabled = false
				count = count + 1
			end
		end
	end

	return count
end

